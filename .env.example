# ==============================================================================
# CHOTLIVE - FILE MẪU CẤU HÌNH MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env và thay đổi các giá trị phù hợp trước khi chạy.
# TUYỆT ĐỐI KHÔNG ĐƯA SECRET THẬT VÀO GIT REPOSITORY.
# ==============================================================================

# 1. CẤU HÌNH CHUNG CỦA ỨNG DỤNG & TÊN MIỀN VPS
# Giá trị hợp lệ: development | test | production
# Lưu ý: Ở chế độ production, hệ thống cấm tự động bật Mock Provider.
APP_ENV=development
DOMAIN=localhost
POSTGRES_USER=chotlive_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=chotlive_db
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# 2. CƠ SỞ DỮ LIỆU & HÀNG ĐỢI
# Với Docker / Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://chotlive_user:CHANGE_ME_DB_PASSWORD@localhost:5432/chotlive_db
# Với Local Development chưa bật Docker (SQLite WAL):
DATABASE_URL=sqlite:///./chotlive_dev.db
REDIS_URL=redis://localhost:6379/0

# 3. BẢO MẬT & MÃ HÓA (THAY THẾ BẰNG CHUỖI NGẪU NHIÊN AN TOÀN TRONG PRODUCTION)
# Tạo bằng lệnh: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_JWT_SECRET_KEY_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Tạo khóa Fernet 32-byte base64 bằng lệnh:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_VALID_32_BYTE_BASE64_FERNET_KEY

# 4. TÍCH HỢP META (FACEBOOK GRAPH API & MESSENGER PLATFORM)
# Để trống trong môi trường development nếu muốn sử dụng chế độ DEMO / MOCK minh bạch.
# Trong production, bắt buộc phải cung cấp thông tin thật từ Meta for Developers.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/meta/oauth/callback
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_WEBHOOK_VERIFY_TOKEN
ALLOW_MOCK_META_IN_DEV=true

# 5. DỊCH VỤ IN ẤN CỤC BỘ (LOCAL PRINT BRIDGE - TÙY CHỌN)
# Dùng khi kết nối trực tiếp máy in nhiệt ESC/POS qua dịch vụ cầu nối nội bộ
PRINT_BRIDGE_URL=http://127.0.0.1:9100
PRINT_BRIDGE_TIMEOUT_SECONDS=5

# 6. CẤU HÌNH FRONTEND (NEXT.JS)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
